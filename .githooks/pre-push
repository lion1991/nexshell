#!/bin/sh
# 推送前对要推上去的新提交跑同一套捷径检查，挡住 --no-verify 提交后直接推送。约定见 docs/shortcut-guard.md。
# 范围与 CI 一致：推 main 查远端 main 之后的提交，其他分支查和远端 main 分叉之后的提交。
checker="$(cd "$(dirname "$0")" && pwd)/check_shortcuts.py" # 和本文件放在同一目录
command -v python3 >/dev/null 2>&1 || { echo "pre-push: 需要 python3 才能运行捷径检查（$checker）" >&2; exit 1; }
remote="$1"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_ref" in refs/tags/*) continue ;; esac
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac # 删除远端分支
	known=""
	case "$remote_sha" in *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && known="$remote_sha" ;; esac
	fork=$(git merge-base "refs/remotes/$remote/main" "$local_sha" 2>/dev/null)
	# 推 main 查远端 main 之后的提交；其他分支查和远端 main 分叉之后的，合并 main、rebase 带进来的别人的行不算
	if [ "$remote_ref" = refs/heads/main ]; then base=${known:-$fork}; else base=${fork:-$known}; fi
	if [ -z "$base" ]; then
		echo "pre-push: 找不到 $remote_ref 的比较基点（本地没有 $remote/main），跳过捷径检查，CI 会再查一遍" >&2
		continue
	fi
	[ "$base" = "$local_sha" ] && continue
	echo "pre-push: 检查 $remote_ref 要推的新提交（$(git rev-parse --short "$base")..$(git rev-parse --short "$local_sha")）" >&2
	python3 "$checker" --range "$base..$local_sha" || status=1
done
exit $status
