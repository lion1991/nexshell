+/// Dump one exact decompressed GFX PDU byte range after ZGFX unwrap and before
+/// typed handling. Enable with `NEXSHELL_RDP_EGFX_GFXPDU_DUMP=<file>`.
+pub(crate) fn dump_raw_gfx_pdu(channel_id: u32, pdu_bytes: &[u8]) {
+    let Some(path) = raw_gfx_pdu_path() else {
+        return;
+    };
+    let seq = RAW_GFX_PDU_SEQ.fetch_add(1, Ordering::Relaxed);
+    let timestamp_us = unix_timestamp_us();
+    if let Ok(mut file) = OpenOptions::new().append(true).open(path) {
+        let _ = file.write_all(&seq.to_le_bytes());
+        let _ = file.write_all(&timestamp_us.to_le_bytes());
+        let _ = file.write_all(&channel_id.to_le_bytes());
+        let _ = file.write_all(&[RAW_GFX_PDU_DIRECTION_S2C]);
+        let _ = file.write_all(&(pdu_bytes.len() as u32).to_le_bytes());
+        let _ = file.write_all(pdu_bytes);
+        let _ = file.flush();
+    }
+}
